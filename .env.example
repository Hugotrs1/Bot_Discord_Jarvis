# Copie ce fichier en « .env » et remplis-le (le guide explique où trouver chaque valeur).
# Seul DISCORD_TOKEN est obligatoire ; les autres lignes ont une valeur par défaut.

# --- Obligatoire ---------------------------------------------------------------
# Token du bot : portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=

# --- Identifiants Discord (mode développeur, puis clic droit > Copier l'identifiant)
# Ton serveur (les commandes y apparaissent tout de suite) :
GUILD_ID=
# Ton compte (toi seul pourras utiliser le bot, et le briefing te sera adressé) :
OWNER_ID=

# --- Général -------------------------------------------------------------------
TIMEZONE=Europe/Paris
DB_PATH=data/jarvis.db

# --- Briefing du matin -----------------------------------------------------------
BRIEF_CHANNEL_ID=
BRIEF_TIME=07:30
# Ville pour la météo (coordonnées : clic droit sur un endroit dans Google Maps)
CITY=Paris
LATITUDE=48.8566
LONGITUDE=2.3522

# --- Salon des alertes (prix et monitoring) ------------------------------------------
ALERTS_CHANNEL_ID=

# --- Suivi des prix -----------------------------------------------------------------
PRICE_CHECK_HOURS=6
# Jour du récap : 0 = lundi … 6 = dimanche, -1 = tous les jours
PRICE_RECAP_WEEKDAY=0
PRICE_RECAP_TIME=09:00

# --- Monitoring ------------------------------------------------------------------------
MONITOR_INTERVAL_MINUTES=5
CPU_ALERT_PERCENT=90
RAM_ALERT_PERCENT=90
DISK_ALERT_PERCENT=90

# --- À lire plus tard -------------------------------------------------------------------
# Salon où l'extension navigateur poste les liens :
READING_CHANNEL_ID=
# Rappel des articles non lus : 5 = samedi
READING_DIGEST_WEEKDAY=5
READING_DIGEST_TIME=10:00
