# Copie ce fichier en « .env » et remplis-le (le guide explique où trouver chaque valeur).

# Token du bot : portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Identifiants Discord (mode développeur activé, puis clic droit > Copier l'identifiant)
# Ton serveur :
GUILD_ID=
# Ton compte :
OWNER_ID=

# Salon du briefing du matin :
BRIEF_CHANNEL_ID=
# Salon des alertes (prix, sites en panne…) :
ALERTS_CHANNEL_ID=
# Salon où l'extension « À lire plus tard » poste les liens :
READING_CHANNEL_ID=

# Ville pour la météo (coordonnées : clic droit sur un endroit dans Google Maps)
CITY=Paris
LATITUDE=48.8566
LONGITUDE=2.3522
