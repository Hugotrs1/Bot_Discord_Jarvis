# --- Obligatoire ------------------------------------------------------------
# Token du bot : https://discord.com/developers/applications > ton appli > Bot > Reset Token
DISCORD_TOKEN=

# ID de ton serveur Discord (clic droit sur le serveur > Copier l'identifiant, mode développeur activé)
# Les commandes y apparaissent instantanément.
GUILD_ID=

# Ton ID utilisateur : seul toi pourras utiliser le bot, et le briefing te sera adressé.
OWNER_ID=

# --- Général ----------------------------------------------------------------
TIMEZONE=Europe/Paris
DB_PATH=data/jarvis.db

# --- Briefing du matin -------------------------------------------------------
BRIEF_CHANNEL_ID=
BRIEF_TIME=07:30
CITY_NAME=Paris
LATITUDE=48.8566
LONGITUDE=2.3522

# --- Alertes (prix + monitoring) ---------------------------------------------
ALERTS_CHANNEL_ID=

# --- Suivi de prix -------------------------------------------------------------
PRICE_CHECK_HOURS=6
# Jour du récap : 0 = lundi … 6 = dimanche, -1 = tous les jours
PRICE_RECAP_WEEKDAY=0
PRICE_RECAP_TIME=09:00

# --- Monitoring ---------------------------------------------------------------
MONITOR_INTERVAL_MINUTES=5
CPU_ALERT_PERCENT=90
RAM_ALERT_PERCENT=90
DISK_ALERT_PERCENT=90

# --- À lire plus tard -----------------------------------------------------------
# Salon où l'extension navigateur poste les liens (via un webhook)
READLATER_CHANNEL_ID=
# Digest : 5 = samedi
READLATER_DIGEST_WEEKDAY=5
READLATER_DIGEST_TIME=10:00
